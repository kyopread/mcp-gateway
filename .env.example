# Copy to .env. npm run dev / npm start and Compose read this file.
# Injected environment variables take precedence over .env values.
# URLs and policies belong in the selected JSON file, not here.
MCP_GATEWAY_CONFIG=config/local.json
# Local Keycloak bootstrap credentials (use different random values).
KEYCLOAK_ADMIN_PASSWORD=
GATEWAY_SMOKE_CLIENT_SECRET=
KEYCLOAK_DIRECTORY_SECRET=
KEYCLOAK_CONSOLE_PASSWORD=
# Optional upstream credentials; required only for configured connections.
VENDOR_MCP_API_KEY=
INTERNAL_MCP_CLIENT_SECRET=
