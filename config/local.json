{
  "port": 3000,
  "timeoutMs": 30000,
  "servers": {
    "alpha": {
      "transport": "stdio",
      "command": "node",
      "args": ["examples/demo-server.mjs", "alpha"],
      "policy": {
        "anyRole": ["client:reader", "client:admin"]
      }
    },
    "beta": {
      "transport": "stdio",
      "command": "node",
      "args": ["examples/demo-server.mjs", "beta"],
      "policy": {
        "anyRole": ["client:admin"]
      }
    }
  },
  "mode": "development",
  "publicUrl": "http://127.0.0.1:3000/mcp",
  "auth": {
    "mode": "keycloak",
    "issuer": "http://127.0.0.1:8080/realms/mcp-gateway",
    "clientId": "mcp-gateway",
    "requiredScopes": ["mcp:access"]
  },
  "console": {
    "enabled": true,
    "databasePath": "data/gateway.sqlite",
    "directory": {
      "clientId": "gateway-directory",
      "clientSecretEnv": "KEYCLOAK_DIRECTORY_SECRET"
    }
  }
}
